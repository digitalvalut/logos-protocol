<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Two devices find each other and then talk to each other directly, so the
         phone needs the network. Nothing said in a conversation passes through
         anything but the two devices themselves. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Asked for at the moment a call is actually placed or answered, never at
         install time, and refusing them leaves messages and files working. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Not something anybody is asked about: it is granted at install and
         shows up in no list. WebRTC audio in a WebView needs it to put the
         device into communication mode, and without it the microphone refuses
         to start at all while the camera opens perfectly well — which reads, to
         whoever is trying to make a call, as "the microphone is already in use
         by another app". -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Writing a received file into Downloads. Not needed from Android 10
         onward, where the same thing goes through MediaStore instead. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- ============ squillo ad app chiusa — ACCESO IL 2 SETTEMBRE 2026 ============
         Fino alla v31 questa sezione era vuota di proposito: le classi c'erano
         ma la riga che le collega alla pagina era commentata, e senza quella
         nessuno di questi permessi aveva senso da chiedere.

         ⚠️ DA SAPERE PRIMA DI INSTALLARE, perché è già successo: la v5 portava
         sette permessi e quattro componenti per questo stesso squillo — che era
         spento — e su alcuni telefoni NON SI INSTALLAVA ("App non installata").
         La v6 li tolse tutti, insieme ad androidx.core, che iniettava di suo un
         DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION. La causa non fu mai riprodotta
         su emulatore: androidx.core resta l'ipotesi migliore, e oggi non c'è più
         (vedi le dipendenze in build.gradle). Ma è un'ipotesi, non una certezza:
         se questa versione non si installa su un telefono dove la v31 si
         installava, la causa è quasi certamente qui sotto.

         Perché ciascuno, uno per uno — un permesso che non si sa spiegare è un
         permesso da togliere:
           FOREGROUND_SERVICE + _SPECIAL_USE : il servizio che resta in ascolto ad
                                               app chiusa si dichiara al sistema, e
                                               da Android 14 deve dire di che tipo è
           POST_NOTIFICATIONS                : da Android 13 la notifica va chiesta;
                                               è come si vede lo squillo
           USE_FULL_SCREEN_INTENT            : fa comparire la schermata di chiamata
                                               sopra il blocco, come una vera telefonata
           WAKE_LOCK                         : tiene sveglio il processore mentre aspetta
           VIBRATE                           : lo squillo vibra
           RECEIVE_BOOT_COMPLETED            : dopo un riavvio l'ascolto riparte da solo,
                                               altrimenti il telefono resta muto senza dirlo

         Nessun servizio esterno, nessun account, nessun Google: ad aspettare è il
         telefono stesso. È la ragione per cui questa strada esiste al posto delle
         notifiche push, che su Android passerebbero comunque da Firebase. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Declared, but not required: a phone with no camera still does messages,
         files and voice, and should not be told the app is unavailable. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Black.NoTitleBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- La schermata che compare quando il telefono squilla. Deve poter
             apparire sopra il blocco, come una telefonata vera: il resto lo fa
             CallActivity da sé con setShowWhenLocked/setTurnScreenOn.
             `exported=false`: la lancia solo il nostro servizio, nessun'altra
             app può farla comparire sullo schermo di qualcuno. -->
        <activity
            android:name=".CallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <!-- Il servizio che resta in ascolto ad app chiusa.
             ⚠️ `specialUse` NON è una scorciatoia: da Android 14 un servizio in
             primo piano deve dichiarare a cosa serve, e nessuno dei tipi
             predefiniti descrive "aspettare che qualcuno chiami su un canale
             cifrato senza passare da un servizio push". Il sottotipo qui sotto
             è obbligatorio con specialUse e va scritto in chiaro: è quello che
             leggerà chi revisiona l'app. -->
        <service
            android:name=".RingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Waits for incoming peer-to-peer calls without any push service, account or third-party infrastructure. The wait is done by the device itself." />
        </service>

        <!-- Dopo un riavvio l'ascolto riparte da solo. Senza questo il telefono
             resterebbe muto senza dirlo a nessuno, che è il modo peggiore in cui
             una funzione può smettere di funzionare. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
